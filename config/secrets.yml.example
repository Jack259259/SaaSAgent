# 资金计划 Agent —— 密钥配置模板。
# 用法:复制为 config/secrets.yml 并填入真实值。config/secrets.yml 已 gitignore,严禁提交(红线 §6)。
#
# - 顶层 KEY 即环境变量名(扁平)。启动期由 agent-gateway 写回进程环境(setdefault)。
# - 优先级:OS 环境变量 / .env  >  本文件  >  config/app.yml  >  代码默认。
# - 留空 = 不设(走代码默认 / 返回 NOT_CONFIGURED);值支持 ${ENV_VAR} 插值(走环境/密管)。
# - 路径可经 FP_SECRETS_CONFIG 覆盖本文件位置。

# LLM API Key。喂给 config/llm.yml 的 ${LLM_API_KEY}(llm.yml 本身不改)。建议走环境/密管。
LLM_API_KEY: ""

# 只读数据库 DSN(红线 6:必须只读账号;含库密码,属密钥)。
DB_DSN_READONLY: ""

# 通知 webhook(可能含 token,按密钥处理)。
NOTIFY_WEBHOOK_URL: ""

# Langfuse 观测(自托管)。LANGFUSE_PUBLIC_KEY 非空才启用 LangfuseTracer,否则降级本地日志。
LANGFUSE_PUBLIC_KEY: ""
LANGFUSE_SECRET_KEY: ""
LANGFUSE_HOST: ""
