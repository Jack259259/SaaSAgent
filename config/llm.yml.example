# 大模型(LLM)配置模板。
# 用法:复制为 config/llm.yml 并填入真实值(config/llm.yml 已 gitignore,勿提交密钥;CLAUDE.md §6)。
# - 值支持 ${ENV_VAR} 插值(推荐密钥走环境/密管);留空或未解析则回退同名环境变量。
# - 配置文件路径可用环境变量 FP_LLM_CONFIG 覆盖(默认 config/llm.yml)。

# API 链接(base URL)。留空 = Anthropic 官方端点;可填中转 / 网关 / 兼容端点。
# 回退顺序:url → 环境 LLM_BASE_URL → 环境 ANTHROPIC_BASE_URL。
url: ""

# API Key。调真实模型必填。建议用 ${LLM_API_KEY} 走环境/密管,也可直接填(注意勿提交)。
api_key: "${LLM_API_KEY}"

# 模型 id。默认 claude-opus-4-8。
model: "claude-opus-4-8"

# 开发桩:true 则用离线 MockProvider(固定作答,无需 api_key),等价于旧 FP_DEV_STUB=1。
dev_stub: false
