# 资金计划 Agent —— 环境变量覆盖样例(可选)。
#
# 配置主入口已迁至 config/ 下的 yml(集中、带注释、可发现):
#   - config/app.yml        非密钥开关/路径/服务地址(已提交)
#   - config/secrets.yml    密钥类(复制 config/secrets.yml.example;不入库,红线 §6)
#   - config/llm.yml        LLM 接口格式/url/api_key/model/dev_stub(复制 .example;不入库)
#
# 优先级:OS 环境变量 / 本 .env  >  config/secrets.yml  >  config/app.yml  >  代码默认。
# 即:这里(或 shell export)设置的值会覆盖上述 yml,仅在需要临时覆盖时使用。
#
# 注意:agent-gateway 不自动加载 .env(make dev 也不带 --env-file)。本文件仅作记录;
# 要让值真正生效,请写入对应 yml,或在启动 shell 里 export(如 `export WREN_API_URL=...`)。
# 密钥严禁提交(.env 已 gitignore)。

# ── 密钥(优先写进 config/secrets.yml)──────────────────────────────────────────
# LLM API Key。缺省时 LLM 调用返回 NOT_CONFIGURED。
LLM_API_KEY=
# 只读数据库 DSN(红线 6:必须只读账号)。缺省时取数执行返回 NOT_CONFIGURED。
DB_DSN_READONLY=
# 通知 webhook(可能含 token)。
NOTIFY_WEBHOOK_URL=
# Langfuse 观测:LANGFUSE_PUBLIC_KEY 非空才启用,否则静默降级本地日志。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── 非密钥(优先写进 config/app.yml)────────────────────────────────────────────
# 取数 NL2SQL 引擎:空(默认)/wren_http=WrenAdapter(legacy);wren_local=嵌入式 WrenAI。
FP_NL2SQL_ENGINE=
# Wren 语义层项目目录(空=assets/semantic-layer/wren)。
FP_WREN_PROJECT_DIR=
# 取数执行器:空/postgres=PostgresExecutor;user_func=data_svc/user_executor.py 的 run_sql。
FP_DATA_EXECUTOR=
# legacy HTTP NL2SQL 服务地址(仅 FP_NL2SQL_ENGINE=wren_http 用)。缺省时返回 NOT_CONFIGURED。
WREN_API_URL=
