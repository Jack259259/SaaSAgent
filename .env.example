# 资金计划 Agent —— 环境变量样例。
# 用法:cp .env.example .env 后按需填写;.env 不入库(已被 .gitignore 忽略,CLAUDE.md §6)。
# 下列各项均为人工对接项:缺省(留空/不设置)时,相关功能不崩溃,
# 而是返回 NOT_CONFIGURED(该语义由各服务在对应实现阶段保证)。

# LLM 厂商标识(如 anthropic)。待人工对接:缺省时 LLM 调用返回 NOT_CONFIGURED。
LLM_PROVIDER=

# LLM API Key。待人工对接:缺省时 LLM 调用返回 NOT_CONFIGURED。严禁写入仓库或日志。
LLM_API_KEY=

# WrenAI 服务地址(如 http://localhost:8000)。待人工对接:缺省时 NL2SQL 取数返回 NOT_CONFIGURED。
WREN_API_URL=

# 只读数据库 DSN(红线 6:必须是只读账号)。待人工对接:缺省时取数执行返回 NOT_CONFIGURED。
DB_DSN_READONLY=

# Langfuse 自托管地址。待人工对接:缺省时观测埋点静默降级为本地日志(NOT_CONFIGURED)。
LANGFUSE_HOST=

# Langfuse API Key。待人工对接:缺省时同上(NOT_CONFIGURED)。
LANGFUSE_KEY=
