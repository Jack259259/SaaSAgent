*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ---- 环境与密钥(CLAUDE.md §6:.env 不入库)----
.env
.env.*
!.env.example
config/llm.yml
!config/llm.yml.example
config/secrets.yml
!config/secrets.yml.example

# ---- IDE / 本地配置 ----
.idea/
.vscode/
