{"embedding_dim": 256, "data": [{"__id__": "ent-9aaccec5cee0472f0d506ececb080347", "__created_at__": 1784350807, "entity_name": "It Design Knowledge Base Upload Area", "content": "It Design Knowledge Base Upload Area\nA directory at data/knowledge/it-design intended for manually uploaded IT design and technical documents, ingested by Rag-Svc into the It Design Library.", "source_id": "it_design:README.md-chunk-000", "file_path": "README.md", "vector": "eJxjYGBgsDVgIBsg66XEHNJtI8dWWwOEamL1QdSBSJgOVJ3IMthtQpOxIM1+3L7GbQKSLy3wmmwCAFX4Ck0="}, {"__id__": "ent-3b2656350ad447925f9d85ea7bf16b41", "__created_at__": 1784350807, "entity_name": "Rag-Svc", "content": "Rag-Svc\nA service that ingests content from the IT Design Knowledge Base Upload Area into the It Design Library.", "source_id": "it_design:README.md-chunk-000", "file_path": "README.md", "vector": "eJxjYKAEuBvh5pGik1gd7maYOmlrK4rtRpSaAtZthm4KueYRow9mGy4TAHItCBY="}, {"__id__": "ent-1a8d03c771531b6bccc02a8060cd6137", "__created_at__": 1784350807, "entity_name": "It Design Library", "content": "It Design Library\nThe knowledge base within Rag-Svc that stores ingested IT design and technical documents.", "source_id": "it_design:README.md-chunk-000", "file_path": "README.md", "vector": "eJxjYBhK4I8RBJOnE5km3hyIOmSbyXMB3DwzUk2hxD6YbdhN/WMEAKw+Ebs="}, {"__id__": "ent-6c5a1512b78c3a83e916ea83eb94c2ad", "__created_at__": 1784350807, "entity_name": "Internal Role", "content": "Internal Role\nThe default role granted retrieval access to the IT Design Knowledge Base Upload Area content.", "source_id": "it_design:README.md-chunk-000", "file_path": "README.md", "vector": "eJxjYEAFaUYMVAEIc/CbSLx9IJVpZuS5Ab9txLiBWuFCTZPOWlBqW5oRAKiOCMI="}, {"__id__": "ent-544496f40e99e2565dc942aa046f57d0", "__created_at__": 1784350807, "entity_name": "Scheme §9.1", "content": "Scheme §9.1\nA section of a scheme that defines the default access permissions for the internal role.", "source_id": "it_design:README.md-chunk-000", "file_path": "README.