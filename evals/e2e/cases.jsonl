# e2e 金标集:剧本(模型如何走)+ 期望终态/事件;无业务标准答案(§10 反模式)。
{"id": "e2e-direct", "kind": "direct", "answer_text": "您好,我可以协助资金计划分析。", "expect": {"stop_reason": "end_turn", "events_include": ["AnswerDeltaEvent", "DoneEvent"]}}
{"id": "e2e-single-tool", "kind": "single_tool", "plan_tools": [{"name": "query_finance_data", "input": {"question": "本月执行率"}}], "answer_text": "本月执行率约 90%。", "expect": {"stop_reason": "end_turn", "events_include": ["ToolResultSummaryEvent", "DoneEvent"]}}
{"id": "e2e-ask-user", "kind": "ask_user", "plan_tools": [{"name": "ask_user", "input": {"questions": [{"id": "q1", "text": "按哪种口径?", "options": ["含在途", "不含在途"]}]}}], "expect": {"paused": true, "events_include": ["AskUserEvent"]}}
{"id": "e2e-plan-basic", "kind": "plan_execute", "plans": [{"steps": [{"id": "s0", "goal": "取本月执行额"}, {"id": "s1", "goal": "取本月计划额"}]}], "step_results": {"s0": {"text": "执行额 90"}, "s1": {"text": "计划额 100"}}, "final_text": "本月执行率 90%。", "expect": {"stop_reason": "completed", "plan_steps": 2, "events_include": ["PlanEvent", "DoneEvent"]}}
{"id": "e2e-cross-capability", "kind": "plan_execute", "plans": [{"steps": [{"id": "d0", "goal": "取数:执行率", "capability_hint": "data"}, {"id": "r0", "goal": "检索:口径说明", "capability_hint": "rag"}, {"id": "c0", "goal": "汇总结论", "depends_on": ["d0", "r0"]}]}], "step_results": {"d0": {"text": "执行率 90%"}, "r0": {"text": "口径:已执行/计划"}, "c0": {"text": "结论:执行良好"}}, "final_text": "执行率 90%,口径为已执行/计划,执行良好。", "expect": {"stop_reason": "completed", "plan_steps": 3, "events_include": ["PlanEvent", "DoneEvent"]}}
{"id": "e2e-plan-confirm", "kind": "plan_confirm", "plans": [{"steps": [{"id": "w0", "goal": "写回计划调整", "needs_confirmation": true}]}], "step_results": {"w0": {"text": "已写回调整"}}, "final_text": "计划调整已完成。", "resume": {"confirm": true}, "expect": {"stop_reason": "completed", "events_include": ["ConfirmRequestEvent", "DoneEvent"]}}
{"id": "e2e-replan", "kind": "replan", "plans": [{"steps": [{"id": "s_bad", "goal": "坏步骤"}]}, {"steps": [{"id": "s_ok", "goal": "修正步骤"}]}], "step_results": {"s_bad": {"fail": true}, "s_ok": {"text": "修正完成"}}, "final_text": "已通过修正路径完成。", "expect": {"stop_reason": "completed", "min_plan_events": 2, "events_include": ["PlanEvent", "DoneEvent"]}}
{"id": "e2e-budget", "kind": "budget", "budget": {"max_steps": 1}, "plans": [{"steps": [{"id": "b0", "goal": "步骤一"}, {"id": "b1", "goal": "步骤二"}]}], "step_results": {"b0": {"text": "a"}, "b1": {"text": "b"}}, "final_text": "x", "expect": {"stop_reason": "budget_exhausted", "events_include": ["DoneEvent"]}}
